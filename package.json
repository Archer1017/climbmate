{
  "name": "climbmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local server/start.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src server tests scripts *.ts *.json index.html README.md",
    "format:check": "prettier --check src server tests scripts *.ts *.json index.html README.md",
    "audit:a11y": "node scripts/audit-a11y.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5",
    "vite": "^8.3.4",
    "typescript": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
